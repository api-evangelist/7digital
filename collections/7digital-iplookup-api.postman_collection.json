          "request": {
            "name": "7digital Resolve Country For Ip",
            "description": {
              "content": "Resolve the country for an end-user's IP address (for geo-restriction checks).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "country",
                "resolve"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ip",
                  "value": "<string>",
                  "description": "(Required) IPv4 or IPv6 address to look up."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
