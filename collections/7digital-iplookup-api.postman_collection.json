                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "ip",
                      "value": "10.0.0.1"
                    },
                    {
                      "key": "oauth_consumer_key",
                      "value": "<API Key>"
                    }
                  ],
                  "variable": []
                },
                "header": [
