{
  "opencollection": "1.0.0",
  "info": {
    "name": "7digital Artists Users API",
    "version": "1.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "oauth_consumer_key",
      "value": "{{oauth_consumer_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "7digital Find Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.7digital.com/1.2/users",
            "params": [
              {
                "name": "email",
                "value": "jane.smith@example.com",
                "type": "query",
                "description": "Filter by user email."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "oauth_consumer_key",
              "value": "{{oauth_consumer_key}}",
              "placement": "query"
            }
          },
          "docs": "Find users in the partner's user directory."
        },
        {
          "info": {
            "name": "7digital Update User",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.7digital.com/1.2/users/:id/update",
            "params": [
              {
                "name": "id",
                "value": "500123",
                "type": "path",
                "description": "The user id to update."
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "apikey",
              "key": "oauth_consumer_key",
              "value": "{{oauth_consumer_key}}",
              "placement": "query"
            }
          },
          "docs": "Update a user's profile."
        }
      ]
    }
  ],
  "bundled": true
}