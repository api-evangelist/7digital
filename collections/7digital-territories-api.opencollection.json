{
  "opencollection": "1.0.0",
  "info": {
    "name": "7digital Artists Territories API",
    "version": "1.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "oauth_consumer_key",
      "value": "{{oauth_consumer_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Territories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "7digital Get Countries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.7digital.com/1.2/countries"
          },
          "docs": "List the supported sales territories with ISO country codes."
        }
      ]
    }
  ],
  "bundled": true
}